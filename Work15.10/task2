num1 = float(input("Введите число: "))
operation = input("Операция (+, -, *, /): ")
num2 = float(input("Введите число: "))

match operation:
    case '+': print(f"{num1} + {num2} = {num1 + num2}")
    case '-': print(f"{num1} - {num2} = {num1 - num2}")
    case '*': print(f"{num1} * {num2} = {num1 * num2}")
    case '/':
        if num2 == 0:
            print("Ошибка: деление на ноль.")
        else:
            print(f"{num1} / {num2} = {num1 / num2}")
    case _:
        print("Неизвестная операция")
