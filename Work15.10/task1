month = int(input("Введите номер месяца (от 1 до 12): "))

match month:
    case 12 | 1 | 2:
        print(f"Месяц: {month}. Время года: Зима ❄️")
    case 3 | 4 | 5:
        print(f"Месяц: {month}. Время года: Весна 🌸")
    case 6 | 7 | 8:
        print(f"Месяц: {month}. Время года: Лето ☀️")
    case 9 | 10 | 11:
        print(f"Месяц: {month}. Время года: Осень 🍂")
    case _:
        print("Ошибка: номер месяца должен быть целым числом от 1 до 12.")
